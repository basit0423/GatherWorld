# Copy this file to .env for local setup, then fill values privately.
# Never upload your real .env file to GitHub or share it in chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FLASK_SECRET_KEY=generate-a-unique-random-secret
ADMIN_USERNAMES=
ADMIN_EMAILS=
APP_ENV=development
FLASK_DEBUG=1
COOKIE_SECURE=0

# Zoho SMTP (outgoing mail)
MAIL_SERVER=smtppro.zoho.com
MAIL_PORT=465
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI — retain the working model that you tested locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90

# Public production URL used for canonical links, robots.txt and sitemap.xml
PUBLIC_BASE_URL=https://gathercommunity.me
